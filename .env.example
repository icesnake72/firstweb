# ==============================================
# 환경 변수 예시 파일 (GitHub에 올라가는 견본)
# 사용법: 이 파일을 복사해 .env 로 이름을 바꾼 뒤 값을 채우세요.
#   cp .env.example .env
# 실제 값은 절대 이 파일에 적지 마세요. (.env 는 .gitignore 로 제외됨)
# 값은 카카오 디벨로퍼스(developers.kakao.com) > 내 애플리케이션에서 확인하세요.
# ==============================================

# [앱 키] 앱 설정 > 앱 키 > REST API 키
# 서버에서 인가 코드를 토큰으로 교환할 때 사용 (client_id)
KAKAO_REST_API_KEY=

# [앱 키] 앱 설정 > 앱 키 > JavaScript 키
# 브라우저에서 Kakao SDK 초기화에 사용 (웹 플랫폼 도메인 등록 필요)
KAKAO_JAVASCRIPT_KEY=

# [보안] 제품 설정 > 카카오 로그인 > 보안 > Client Secret
# 토큰 교환 시 함께 전송 (활성화 상태로 설정 권장)
KAKAO_CLIENT_SECRET=

# [Redirect URI] 제품 설정 > 카카오 로그인 > Redirect URI 에 등록한 주소와 정확히 같아야 함
# 형식: <사이트 주소>/auth/kakao/callback
# 배포 사이트용 값은 Netlify 대시보드 > Site configuration > Environment variables 에 등록하세요.
KAKAO_REDIRECT_URI=

# [로그아웃 Redirect URI] 제품 설정 > 카카오 로그인 > Logout Redirect URI
# 형식: <사이트 주소>/
KAKAO_LOGOUT_REDIRECT_URI=

# [뉴스] newsapi.org > Account > API key
# 뉴스 페이지(/news.html)가 서버 함수(/api/news)를 통해 기사를 불러올 때 사용
# 무료(Developer) 플랜: 하루 100회, 기사 24시간 지연, 개발·테스트 용도로만 허용
NEWS_API_KEY=

# [날씨] home.openweathermap.org > API keys
# 서버 함수(/api/weather)에서만 사용 (무료: 지오코딩·현재 날씨·5일 예보)
OPEN_WEATHER_API_KEY=

# [AI 챗봇] console.anthropic.com > API Keys
# 서버 함수(/api/chat)에서만 사용
ANTHROPIC_API_KEY=

# 로그인 세션/쿠키 서명용 임의의 긴 문자열 (직접 생성)
# 생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
